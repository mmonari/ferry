#!/bin/sh
# Build the ferry package from this checkout and install it: `makepkg -fsi` in pkgbuild/.
#
#   bin/install [makepkg options]
#
# Needs: cargo (rust), base-devel. pacman asks for sudo twice: once for the build dependencies
# (-s) and once for the install (-i). Extra options go to makepkg, e.g. `bin/install --noconfirm`.
# After it: run `ferry setup`. Docs: docs/packaging.md.
set -eu
case ${1:-} in
  -h | --help)
    sed -n '2,8p' "$0"
    exit 0
    ;;
esac
ROOT="$(CDPATH='' cd -- "$(dirname -- "$0")/.." && pwd)"
cd "$ROOT/pkgbuild"
makepkg -fsi "$@"
