[Desktop Entry]
Type=Application
Name=ferry
GenericName=Keyboard and mouse sharing
Comment=Arrange screens, pair machines and tune ferry
# `ferry ui` asks the running Omarchy shell to open the panel (the plugin's IPC target `ferry`, see
# plugin/README.md); it works without a terminal and without $OMARCHY_PATH. It centres the panel on
# the monitor that has the focus (FR-UI-18). Needs the plugin, which `ferry setup` links and enables.
Exec=ferry ui arrange
Icon=input-mouse
Terminal=false
StartupNotify=false
Categories=Settings;HardwareSettings;
Keywords=keyboard;mouse;kvm;share;screens;layout;arrange;pair;
Actions=pair;settings;

[Desktop Action pair]
Name=Pair a machine
Exec=ferry ui pair

[Desktop Action settings]
Name=Settings
Exec=ferry ui settings
